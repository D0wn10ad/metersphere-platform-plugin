{
  "serviceIntegration": {
    "label": "Phabricator",
    "image": "/static/index.png",
    "tips": "请在 Phabricator 设置中生成 API Token (Settings → API Tokens)",
    "formItems": [
      {
        "name": "url",
        "type": "input",
        "defaultValue": "",
        "required": true,
        "i18n": true,
        "label": "Phorge URL",
        "message": "organization.integration.input_phabricator_url"
      },
      {
        "name": "apiToken",
        "type": "password",
        "defaultValue": "",
        "required": true,
        "i18n": true,
        "label": "Phorge API Token",
        "message": "organization.integration.input_api_token"
      },
      {
        "name": "debugMode",
        "type": "radio",
        "defaultValue": "true",
        "required": false,
        "i18n": true,
        "label": "Debug Mode",
        "tips": "启用后将在日志中打印 API 请求和响应内容",
        "options": [
          {"text": "Enabled", "value": "true"},
          {"text": "Disabled", "value": "false"}
        ]
      },
      {
        "name": "msUrl",
        "type": "input",
        "required": false,
        "label": "Metersphere URL",
        "placeholder": "https://metersphere.example.com"
      },
      {
        "name": "syncPriority",
        "type": "radio",
        "defaultValue": "true",
        "required": false,
        "i18n": true,
        "label": "Sync Priority",
        "tips": "Sync priority from severity when creating/updating issues",
        "options": [
          {"text": "Enabled", "value": "true"},
          {"text": "Disabled", "value": "false"}
        ]
      },
      {
        "name": "syncEnvironment",
        "type": "radio",
        "defaultValue": "true",
        "required": false,
        "i18n": true,
        "label": "Sync Environment",
        "tips": "Sync custom.igus.env field when creating/updating issues",
        "options": [
          {"text": "Enabled", "value": "true"},
          {"text": "Disabled", "value": "false"}
        ]
      }
    ]
  },

  "projectConfig": {
    "formItems": [
      {
        "name": "projectPHID",
        "type": "input",
        "defaultValue": "",
        "required": true,
        "i18n": true,
        "label": "project.phabricator_project",
        "withProjectCheck": true,
        "message": "project.platform.phabricator_project_require"
      }
    ]
  },

  "accountConfig": {
    "label": "organization.integration.phabricator_info",
    "instructionsInfo": "organization.integration.phabricator_prompt_information",
    "i18n": true,
    "formItems": [
      {
        "name": "apiToken",
        "type": "password",
        "defaultValue": "",
        "required": false,
        "i18n": true,
        "label": "organization.integration.api_token",
        "message": "organization.integration.input_api_token"
      }
    ]
  }
}
