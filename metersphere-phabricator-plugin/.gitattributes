# Handle line endings automatically for files detected as text
* text=auto

# Java sources
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Documentation
*.txt text eol=lf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary